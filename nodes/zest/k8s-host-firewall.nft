table inet k8s_host
delete table inet k8s_host

table inet k8s_host {
  set control_planes {
    type ipv4_addr
    elements = { 147.46.91.26, 147.46.91.46, 147.46.91.49 }
  }

  set nodes {
    type ipv4_addr
    elements = { 147.46.91.26, 147.46.91.46, 147.46.91.49 }
  }

  set cluster_sources {
    type ipv4_addr
    flags interval
    elements = { 147.46.91.26, 147.46.91.46, 147.46.91.49, 10.244.0.0/16, 10.200.0.0/24 }
  }

  chain input {
    type filter hook input priority filter - 10; policy accept;
    iif lo accept
    meta nfproto ipv6 tcp dport { 2379, 2380, 4240, 4244, 9964, 10250 } drop
    meta nfproto ipv6 udp dport 8472 drop
    tcp dport { 2379, 2380 } ip saddr != @control_planes drop
    tcp dport { 4240, 4244, 9964, 10250 } ip saddr != @cluster_sources drop
    udp dport 8472 ip saddr != @nodes drop
  }
}
