#!/usr/sbin/nft -f
# Managed by cd-manifests/cloudstack/hosts (Ansible). Do not edit by hand.
# Each file in /etc/nftables.d deletes and recreates only its own table, in one
# transaction: the CloudStack agent keeps its security group rules in other
# tables, which must never be flushed.
include "/etc/nftables.d/*.nft"
