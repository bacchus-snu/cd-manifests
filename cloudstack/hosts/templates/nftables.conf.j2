#!/usr/sbin/nft -f
# Managed by cd-manifests/cloudstack/hosts (Ansible). Do not edit by hand.
# Only this table is (re)loaded: the CloudStack agent keeps its own security
# group rules in other tables, which must never be flushed.

table inet cloudstack_gw
flush table inet cloudstack_gw

table inet cloudstack_gw {
    # Bacchus internal networks and the management overlay: never reachable from guests
    set guest_blocked {
        type ipv4_addr
        flags interval
        elements = { {{ guest_blocked_networks | join(', ') }} }
    }

    # Frames a VM sends beyond the guest network are first seen while bridged
    # on the security-group bridge (bridge-nf-call-iptables is on). If conntrack
    # confirmed them there, the NAT decision would be taken before routing and
    # masquerade would never apply. Track them only once they reach the overlay
    # bridge, where they are routed.
    chain prerouting {
        type filter hook prerouting priority raw; policy accept;
        iifname "{{ overlays.guest.bridge }}" ip saddr {{ overlays.guest.network }} ip daddr != {{ overlays.guest.network }} notrack
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname "{{ overlays.guest.overlay_bridge }}" ip daddr @guest_blocked drop
        # the overlays carry 1450-byte frames: size TCP segments at the gateway
        # instead of relying on path MTU discovery
        tcp flags syn tcp option maxseg size set 1410
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "cloudbr0" ip saddr {{ overlays.guest.network }} masquerade
    }
}
