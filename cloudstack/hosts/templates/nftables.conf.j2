#!/usr/sbin/nft -f
# Managed by cd-manifests/cloudstack/hosts (Ansible). Do not edit by hand.
# Only this table is (re)loaded: the CloudStack agent keeps its own security
# group rules in other tables, which must never be flushed.

table inet cloudstack_gw
flush table inet cloudstack_gw

table inet cloudstack_gw {
    # Bacchus internal networks and the management overlay: never reachable from guests
    set guest_blocked {
        type ipv4_addr
        flags interval
        elements = { {{ guest_blocked_networks | join(', ') }} }
    }

    # Frames are tracked twice on this host: once while bridged on the
    # security-group bridge (bridge-nf-call-iptables is on) and once when routed
    # on the overlay bridge. Sharing one conntrack entry breaks both: the NAT
    # decision would be taken on the bridge, where no masquerade rule matches,
    # and replies, seen untranslated on the bridge, would never match the entry
    # translated on the way out. Keep the bridge's view in its own zone so the
    # security-group rules see a consistent connection and NAT is decided only
    # where the packet is routed.
    chain prerouting {
        type filter hook prerouting priority raw; policy accept;
        iifname "{{ overlays.guest.bridge }}" ct zone set 1
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname "{{ overlays.guest.overlay_bridge }}" ip daddr @guest_blocked drop
        # the overlays carry 1450-byte frames: size TCP segments at the gateway
        # instead of relying on path MTU discovery
        tcp flags syn tcp option maxseg size set 1410
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "cloudbr0" ip saddr {{ overlays.guest.network }} masquerade
    }
}
