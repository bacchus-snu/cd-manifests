# Managed by cd-manifests/cloudstack/hosts (Ansible). Do not edit by hand.
# DNS for guests on the overlay gateway address. It knows no names of its own
# and forwards every query upstream, so guests cannot look each other up.
# The guest domain, which guests search, is answered here and never
# forwarded: the public zone returns an empty answer for names under it, and
# musl's resolver stops its search on an empty answer (glibc goes on to the
# bare name), so a short name would never reach the bare-name lookup.
listen-address={{ overlays.guest.gateway }}
bind-dynamic
port=53
no-hosts
no-resolv
domain-needed
bogus-priv
cache-size=1000
{% for s in campus_dns %}
server={{ s }}
{% endfor %}
local=/{{ overlays.guest.domain }}/
