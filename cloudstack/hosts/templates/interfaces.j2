# Managed by cd-manifests/cloudstack/hosts (Ansible). Do not edit by hand.
# Applied by reboot only; never switch a live network with ifdown/ifup.
source /etc/network/interfaces.d/*

auto lo
iface lo inet loopback

auto eth0
iface eth0 inet manual

# Campus: host address and VXLAN endpoint. The bridge must keep the physical
# NIC's MAC because the campus network binds addresses to registered MACs.
auto cloudbr0
iface cloudbr0 inet static
        bridge_ports eth0
        bridge_fd 5
        bridge_stp off
        bridge_maxwait 1
        hwaddress ether {{ campus_mac }}
        address {{ campus_ip }}/{{ campus_prefix }}
        gateway {{ campus_gateway }}
        dns-nameservers {{ campus_dns | join(' ') }}
        dns-search snucse.org

{% for name, o in overlays.items() %}
# {{ name }} overlay, VNI {{ o.vni }}: static unicast VXLAN with head-end
# replication to every other VTEP (no multicast on the campus network)
auto vx{{ o.vni }}
iface vx{{ o.vni }} inet manual
        pre-up ip link show vx{{ o.vni }} >/dev/null 2>&1 || ip link add vx{{ o.vni }} type vxlan id {{ o.vni }} dstport 4789 local {{ campus_ip }} ttl 64
        pre-up ip link set vx{{ o.vni }} mtu 1450
{% for peer in vtep_peers %}
        up bridge fdb append 00:00:00:00:00:00 dev vx{{ o.vni }} dst {{ peer }} || true
{% endfor %}
        post-down ip link del vx{{ o.vni }}

{% endfor %}
{% set m = overlays.mgmt %}
# Management overlay: the host's own address and the system VMs' management
# and storage NICs share this bridge (the agent reads its private address from
# the device the management NICs attach to). Nothing is routed here; the pod
# gateway is the waiter overlay gateway.
auto {{ m.bridge }}
iface {{ m.bridge }} inet static
        bridge_ports vx{{ m.vni }}
        bridge_fd 0
        bridge_stp off
        bridge_maxwait 1
        address {{ mgmt_ip }}/{{ m.prefix }}

{% set g = overlays.guest %}
# Guest overlay, two bridges. The agent's security-group firewall drops routed
# traffic entering or leaving any bridge that carries VM taps and lets VM
# frames out only through that bridge's single uplink port, so the taps'
# bridge holds nothing but taps and one end of a veth. The other end joins the
# overlay bridge with the VXLAN device and, on gateway hosts, the gateway
# address: seen from the VMs the router sits beyond the uplink, and routing
# happens on a bridge the agent does not firewall.
auto {{ g.overlay_bridge }}
iface {{ g.overlay_bridge }} inet manual
        pre-up ip link show up{{ g.vni }} >/dev/null 2>&1 || ip link add up{{ g.vni }} type veth peer name dn{{ g.vni }}
        pre-up ip link set up{{ g.vni }} mtu 1450
        pre-up ip link set dn{{ g.vni }} mtu 1450
        bridge_ports vx{{ g.vni }} dn{{ g.vni }}
        bridge_fd 0
        bridge_stp off
        bridge_maxwait 1
        post-down ip link del up{{ g.vni }}

auto {{ g.bridge }}
iface {{ g.bridge }} inet manual
        bridge_ports up{{ g.vni }}
        bridge_fd 0
        bridge_stp off
        bridge_maxwait 1
