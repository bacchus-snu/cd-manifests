# Managed by cd-manifests/cloudstack/hosts (Ansible). Do not edit by hand.
# One VRRP instance elects the router of the guest overlay. Adverts travel on
# the management overlay (unicast between the gateway hosts); the gateway
# address lives on the guest overlay bridge of the elected host.
global_defs {
    router_id {{ inventory_hostname }}
    vrrp_skip_check_adv_addr
}

vrrp_instance cloudstack {
    state BACKUP
    interface {{ overlays.mgmt.bridge }}
    virtual_router_id {{ overlays.mgmt.vni }}
    priority {{ vrrp_priority }}
    advert_int 1
    unicast_src_ip {{ mgmt_ip }}
    unicast_peer {
{% for h in groups['cloudstack_gateway'] if h != inventory_hostname %}
        {{ hostvars[h].mgmt_ip }}
{% endfor %}
    }
    virtual_ipaddress {
        {{ overlays.guest.gateway }}/{{ overlays.guest.prefix }} dev {{ overlays.guest.overlay_bridge }}
    }
}
