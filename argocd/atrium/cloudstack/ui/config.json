{
  "apiBase": "/client/api",
  "servers": [
    {
      "name": "Local-Server",
      "apiHost": "",
      "apiBase": "/client/api"
    }
  ],
  "docBase": "https://docs.cloud.snucse.org",
  "appTitle": "SNUCSE Cloud",
  "footer": "<a href='https://bacchus.snucse.org' target='_blank'>Bacchus</a>가 운영합니다. Licensed under the <a href='http://www.apache.org/licenses/' target='_blank'>Apache License</a>, Version 2.0.",
  "loginTitle": "SNUCSE Cloud",
  "loginFavicon": "assets/logo.svg",
  "loginFooter": "<style>.user-layout-container{top:auto!important;transform:none!important;margin-top:0!important;padding:8vh 0 0!important}.user-layout-footer{position:static!important;margin:12px 0 24px}.user-layout-footer label{width:auto!important}body.userLayout .ant-notification,body.userLayout .button-clear-notification{display:none!important}</style><div style='width:500px;max-width:calc(100vw - 32px);margin:0 auto 40px;color:rgba(0,0,0,.45);font-size:13px'>학생은 SNUCSE ID로 로그인합니다.</div><a href='https://bacchus.snucse.org' target='_blank' style='display:inline-flex;align-items:center;gap:8px;font-size:16px'><img src='assets/bacchus.png' alt='' style='height:36px'><b>Bacchus</b></a><br><a href='https://docs.cloud.snucse.org/' target='_blank'>사용 안내</a> · <a href='mailto:contact@bacchus.snucse.org'>문의</a>",
  "resetPasswordFooter": "",
  "logo": "assets/logo.svg",
  "minilogo": "assets/mini-logo.svg",
  "banner": "assets/banner.svg",
  "favicon": "cloud.ico",
  "error": {
    "403": "assets/403.png",
    "404": "assets/404.png",
    "500": "assets/500.png"
  },
  "theme": {
    "@layout-mode": "light",
    "@logo-background-color": "#ffffff",
    "@mini-logo-background-color": "#ffffff",
    "@navigation-background-color": "#ffffff",
    "@project-nav-background-color": "#001529",
    "@project-nav-text-color": "rgba(255, 255, 255, 0.65)",
    "@navigation-text-color": "rgba(0, 0, 0, 0.65)",
    "@primary-color": "#1890ff",
    "@link-color": "#1890ff",
    "@link-hover-color": "#40a9ff",
    "@loading-color": "#1890ff",
    "@processing-color": "#1890ff",
    "@success-color": "#52c41a",
    "@warning-color": "#faad14",
    "@error-color": "#f5222d",
    "@font-size-base": "14px",
    "@heading-color": "rgba(0, 0, 0, 0.85)",
    "@text-color": "rgba(0, 0, 0, 0.65)",
    "@text-color-secondary": "rgba(0, 0, 0, 0.45)",
    "@disabled-color": "rgba(0, 0, 0, 0.25)",
    "@border-color-base": "#d9d9d9",
    "@border-radius-base": "4px",
    "@box-shadow-base": "0 2px 8px rgba(0, 0, 0, 0.15)",
    "@logo-width": "256px",
    "@logo-height": "64px",
    "@mini-logo-width": "80px",
    "@mini-logo-height": "64px",
    "@banner-width": "700px",
    "@banner-height": "110px",
    "@error-width": "256px",
    "@error-height": "256px"
  },
  "keyboardOptions": {
    "us": "label.standard.us.keyboard",
    "uk": "label.uk.keyboard",
    "fr": "label.french.azerty.keyboard",
    "jp": "label.japanese.keyboard",
    "sc": "label.simplified.chinese.keyboard",
    "es-latam": "Spanish Latin American Keyboard"
  },
  "userCard": {
    "enabled": true,
    "title": "label.help",
    "icon": "question-circle-outlined",
    "links": [
      {
        "title": "사용 안내",
        "text": "SNUCSE Cloud 사용 안내",
        "link": "https://docs.cloud.snucse.org/",
        "icon": "read-outlined"
      },
      {
        "title": "문의",
        "text": "Bacchus에 문의하기 (contact@bacchus.snucse.org)",
        "link": "mailto:contact@bacchus.snucse.org",
        "icon": "mail-outlined"
      }
    ]
  },
  "plugins": [
    {
      "name": "사용 안내",
      "path": "https://docs.cloud.snucse.org/",
      "isExternalLink": "true"
    }
  ],
  "allowMakingRouterRedundant": false,
  "apidocs": true,
  "basicZoneEnabled": true,
  "multipleServer": false,
  "allowSettingTheme": false,
  "displayProjectFieldOnLogin": false,
  "foldPasswordLogin": true,
  "imageSelectionInterface": "modern",
  "showUserCategoryForModernImageSelection": true,
  "showAllCategoryForModernImageSelection": false,
  "docHelpMappings": {
    "adminguide/virtual_machines.html": "instance.html",
    "adminguide/storage.html": "instance.html",
    "adminguide/": "https://docs.cloudstack.apache.org/en/4.23.0.0/adminguide/",
    "installguide/": "https://docs.cloudstack.apache.org/en/4.23.0.0/installguide/",
    "conceptsandterminology/": "https://docs.cloudstack.apache.org/en/4.23.0.0/conceptsandterminology/",
    "plugins/": "https://docs.cloudstack.apache.org/en/4.23.0.0/plugins/"
  },
  "notifyLatestCSVersion": true,
  "showSearchFilters": true,
  "announcementBanner": {
    "enabled": true,
    "showIcon": true,
    "closable": true,
    "persistDismissal": true,
    "type": "warning",
    "message": "<strong>SNUCSE Cloud는 준비 중입니다.</strong> 신규 자원 편입과 리소스 쿼터 조정 작업 중이라 지금은 로그인해 둘러보기만 할 수 있습니다. 정식 오픈은 SNUCSE ID와 <a href='https://docs.cloud.snucse.org/' target='_blank'>사용 안내</a>에서 알려 드립니다."
  },
  "defaultLanguage": "ko_KR",
  "showGpuSlots": true,
  "showCpuSpeed": false,
